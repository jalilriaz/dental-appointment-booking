{
  "name": "dental-appointment-booking-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "turbo run build",
    "start": "pnpm --filter frontend start",
    "db:clean": "pnpm --filter backend run db:clean",
    "db:seed": "pnpm --filter backend run prisma:seed",
    "db:feed": "pnpm --filter backend run db:feed",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0"
  }
}

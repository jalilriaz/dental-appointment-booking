{
  "name": "dental-appointment-booking-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:frontend:webpack": "pnpm --filter frontend dev:webpack",
    "dev:backend": "pnpm --filter backend dev",
